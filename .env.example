# Copy to .env for local development. Values below are placeholders.
#
# The app reads exactly ONE pair of Shopify credential variable names —
# SHOPIFY_API_KEY and SHOPIFY_API_SECRET (see app/shopify.server.ts). Do not
# also set SHOPIFY_CLIENT_ID / SHOPIFY_CLIENT_SECRET in Vercel or anywhere
# else; the app never reads those names, and having both a real pair and an
# unused alias around a project is how deployments end up pointed at stale
# credentials without anyone noticing.
#
# Get the current values with: npx shopify app env show

# Shopify App Credentials (from Shopify Partner Dashboard -> Apps -> Client Credentials)
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SCOPES="write_products,read_orders,write_orders"

# Set automatically by `shopify app dev` locally. In production (e.g. Vercel),
# set this to the app's stable public URL.
SHOPIFY_APP_URL=""

# Upstash Redis Credentials (from Upstash Console -> Database -> REST API)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Postgres connection string (session storage)
DATABASE_URL=""

# Shared secret for authorizing calls to /api/cleanup-drops. If deployed on
# Vercel and you name this CRON_SECRET instead, Vercel's native Cron Jobs
# feature (if you use it) will inject the Authorization header automatically
# — see the "Background jobs and drop resolution" section in README.md.
CLEANUP_CRON_SECRET=""
